+        class_pointer = "externalptr",
+        size          = "integer",
         void          = "logical",
-        const         = "logical", 
-        docstrings    = "character", 
-        signatures    = "character", 
+        const         = "logical",
+        docstrings    = "character",
+        signatures    = "character",
         nargs         = "integer"
-    ), 
-    methods = list( 
-        info = function(prefix = "    " ){
-             paste( 
